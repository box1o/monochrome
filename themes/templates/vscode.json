{
  "name": "Mono",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#{{colors.foreground}}",
    "descriptionForeground": "#{{colors.muted}}",
    "disabledForeground": "#{{colors.border}}",
    "focusBorder": "#{{colors.border}}",
    "errorForeground": "#{{colors.red}}",
    "icon.foreground": "#{{colors.foreground}}",
    "editor.background": "#{{colors.background}}",
    "editor.foreground": "#{{colors.foreground}}",
    "editorCursor.foreground": "#{{colors.accent}}",
    "editor.lineHighlightBackground": "#{{colors.surface}}",
    "editorLineNumber.foreground": "#{{colors.muted}}",
    "editorLineNumber.activeForeground": "#{{colors.accent}}",
    "editor.selectionBackground": "#{{colors.accent}}66",
    "editor.selectionHighlightBackground": "#{{colors.accent}}26",
    "editor.wordHighlightBackground": "#{{colors.accent}}26",
    "editor.wordHighlightStrongBackground": "#{{colors.accent}}40",
    "editor.findMatchBackground": "#{{colors.accent}}",
    "editor.findMatchForeground": "#{{colors.on_accent}}",
    "editor.findMatchHighlightBackground": "#{{colors.yellow}}40",
    "editorBracketMatch.background": "#{{colors.surface_bright}}",
    "editorBracketMatch.border": "#{{colors.accent}}",
    "editorWhitespace.foreground": "#{{colors.surface_bright}}",
    "editorIndentGuide.background1": "#{{colors.surface_bright}}",
    "editorIndentGuide.activeBackground1": "#{{colors.border}}",
    "editorGutter.addedBackground": "#{{colors.green}}",
    "editorGutter.modifiedBackground": "#{{colors.yellow}}",
    "editorGutter.deletedBackground": "#{{colors.red}}",
    "editorError.foreground": "#{{colors.red}}",
    "editorWarning.foreground": "#{{colors.yellow}}",
    "editorInfo.foreground": "#{{colors.blue}}",
    "editorHint.foreground": "#{{colors.cyan}}",
    "editorWidget.background": "#{{colors.surface}}",
    "editorWidget.border": "#{{colors.surface_bright}}",
    "editorSuggestWidget.background": "#{{colors.surface}}",
    "editorSuggestWidget.foreground": "#{{colors.foreground}}",
    "editorSuggestWidget.selectedBackground": "#{{colors.surface_bright}}",
    "editorSuggestWidget.highlightForeground": "#{{colors.accent}}",
    "editorHoverWidget.background": "#{{colors.surface}}",
    "editorHoverWidget.border": "#{{colors.surface_bright}}",
    "sideBar.background": "#{{colors.background}}",
    "sideBar.foreground": "#{{colors.foreground}}",
    "sideBarTitle.foreground": "#{{colors.muted}}",
    "sideBarSectionHeader.background": "#{{colors.surface}}",
    "activityBar.background": "#{{colors.background}}",
    "activityBar.foreground": "#{{colors.foreground}}",
    "activityBar.inactiveForeground": "#{{colors.muted}}",
    "activityBarBadge.background": "#{{colors.accent}}",
    "activityBarBadge.foreground": "#{{colors.on_accent}}",
    "titleBar.activeBackground": "#{{colors.background}}",
    "titleBar.activeForeground": "#{{colors.foreground}}",
    "titleBar.inactiveBackground": "#{{colors.background}}",
    "titleBar.inactiveForeground": "#{{colors.muted}}",
    "editorGroupHeader.tabsBackground": "#{{colors.background}}",
    "tab.activeBackground": "#{{colors.surface}}",
    "tab.activeForeground": "#{{colors.foreground}}",
    "tab.inactiveBackground": "#{{colors.background}}",
    "tab.inactiveForeground": "#{{colors.muted}}",
    "tab.activeBorderTop": "#{{colors.accent}}",
    "panel.background": "#{{colors.background}}",
    "panel.border": "#{{colors.surface_bright}}",
    "statusBar.background": "#{{colors.surface}}",
    "statusBar.foreground": "#{{colors.foreground}}",
    "statusBar.noFolderBackground": "#{{colors.surface}}",
    "statusBar.debuggingBackground": "#{{colors.surface_bright}}",
    "statusBar.debuggingForeground": "#{{colors.foreground}}",
    "input.background": "#{{colors.surface}}",
    "input.foreground": "#{{colors.foreground}}",
    "input.border": "#{{colors.surface_bright}}",
    "input.placeholderForeground": "#{{colors.muted}}",
    "dropdown.background": "#{{colors.surface}}",
    "dropdown.foreground": "#{{colors.foreground}}",
    "dropdown.border": "#{{colors.surface_bright}}",
    "button.background": "#{{colors.accent}}",
    "button.foreground": "#{{colors.on_accent}}",
    "button.secondaryBackground": "#{{colors.surface_bright}}",
    "button.secondaryForeground": "#{{colors.foreground}}",
    "badge.background": "#{{colors.surface_bright}}",
    "badge.foreground": "#{{colors.foreground}}",
    "list.activeSelectionBackground": "#{{colors.surface_bright}}",
    "list.activeSelectionForeground": "#{{colors.foreground}}",
    "list.inactiveSelectionBackground": "#{{colors.surface}}",
    "list.hoverBackground": "#{{colors.surface}}",
    "list.highlightForeground": "#{{colors.accent}}",
    "quickInput.background": "#{{colors.surface}}",
    "notificationCenterHeader.background": "#{{colors.surface}}",
    "notifications.background": "#{{colors.surface}}",
    "notifications.foreground": "#{{colors.foreground}}",
    "notifications.border": "#{{colors.surface_bright}}",
    "terminal.background": "#{{colors.background}}",
    "terminal.foreground": "#{{colors.foreground}}",
    "terminal.ansiBlack": "#{{colors.black}}",
    "terminal.ansiRed": "#{{colors.red}}",
    "terminal.ansiGreen": "#{{colors.green}}",
    "terminal.ansiYellow": "#{{colors.yellow}}",
    "terminal.ansiBlue": "#{{colors.blue}}",
    "terminal.ansiMagenta": "#{{colors.magenta}}",
    "terminal.ansiCyan": "#{{colors.cyan}}",
    "terminal.ansiWhite": "#{{colors.white}}",
    "terminal.ansiBrightBlack": "#{{colors.muted}}",
    "terminal.ansiBrightRed": "#{{colors.red}}",
    "terminal.ansiBrightGreen": "#{{colors.green}}",
    "terminal.ansiBrightYellow": "#{{colors.yellow}}",
    "terminal.ansiBrightBlue": "#{{colors.blue}}",
    "terminal.ansiBrightMagenta": "#{{colors.magenta}}",
    "terminal.ansiBrightCyan": "#{{colors.cyan}}",
    "terminal.ansiBrightWhite": "#{{colors.foreground}}"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#{{colors.muted}}", "fontStyle": "italic" } },
    { "scope": ["constant", "constant.numeric"], "settings": { "foreground": "#{{colors.yellow}}" } },
    { "scope": "string", "settings": { "foreground": "#{{colors.green}}" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#{{colors.foreground}}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#{{colors.blue}}" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#{{colors.accent}}", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#{{colors.cyan}}", "fontStyle": "" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#{{colors.cyan}}" } },
    { "scope": ["meta.preprocessor", "entity.name.tag"], "settings": { "foreground": "#{{colors.magenta}}" } },
    { "scope": "invalid", "settings": { "foreground": "#{{colors.red}}" } }
  ],
  "semanticTokenColors": {
    "variable": "#{{colors.foreground}}",
    "parameter": "#{{colors.foreground}}",
    "property": "#{{colors.foreground}}",
    "function": "#{{colors.blue}}",
    "method": "#{{colors.blue}}",
    "type": "#{{colors.cyan}}",
    "class": "#{{colors.cyan}}",
    "interface": "#{{colors.cyan}}",
    "enum": "#{{colors.cyan}}",
    "enumMember": "#{{colors.yellow}}",
    "keyword": { "foreground": "#{{colors.accent}}", "italic": true },
    "string": "#{{colors.green}}",
    "number": "#{{colors.yellow}}",
    "comment": { "foreground": "#{{colors.muted}}", "italic": true },
    "operator": "#{{colors.cyan}}"
  }
}
