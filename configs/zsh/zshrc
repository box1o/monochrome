[[ -o interactive ]] || return 0

MONO_SHELL_HOME=${MONO_SHELL_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mono/shell}
if [[ ! -r "$MONO_SHELL_HOME/shared.sh" ]]; then
    MONO_SHELL_HOME="${${(%):-%x}:A:h}/../shell"
fi

source "$MONO_SHELL_HOME/shared.sh" || return

# Bootstrap optional plugins through the common execution layer.
ZINIT_HOME=${ZINIT_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git}
if [[ ! -r "$ZINIT_HOME/zinit.zsh" ]] && profile::exists git; then
    profile::run fs::mkdir "${ZINIT_HOME%/*}"
    profile::run git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

if [[ ${SHELL_LIB_DRY_RUN:-false} != true ]]; then
    if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
        source "$ZINIT_HOME/zinit.zsh"

        for plugin in zsh-users/zsh-completions Aloxaf/fzf-tab; do
            zinit light "$plugin"
        done

        for plugin in git sudo aws kubectl kubectx command-not-found; do
            zinit snippet "OMZP::$plugin"
        done
    fi

    autoload -Uz compinit
    compinit

    if (( $+functions[zinit] )); then
        zinit cdreplay -q
        zinit light zsh-users/zsh-autosuggestions
        zinit light zsh-users/zsh-syntax-highlighting
    fi
fi
unset plugin

bindkey -v
bindkey '^k' history-search-backward
bindkey '^j' history-search-forward

HISTSIZE=5000
SAVEHIST=5000
HISTFILE="$HOME/.zsh_history"

setopt appendhistory sharehistory
setopt hist_ignore_space hist_ignore_all_dups hist_save_no_dups

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color=auto "$realpath"'

profile::exists fzf && eval "$(profile::query fzf --zsh)"
profile::exists zoxide && eval "$(profile::query zoxide init --cmd cd zsh)"
profile::exists starship && eval "$(profile::query starship init zsh)"

alias g='nvim ~/.zshrc'
alias s='source ~/.zshrc'
