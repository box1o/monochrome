# shellcheck shell=bash
[[ $- == *i* ]] || return 0

MONO_SHELL_HOME=${MONO_SHELL_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mono/shell}
if [[ ! -r "$MONO_SHELL_HOME/shared.sh" ]]; then
    MONO_SHELL_HOME="${BASH_SOURCE[0]%/*}/../shell"
fi

# shellcheck source=../shell/shared.sh
source "$MONO_SHELL_HOME/shared.sh" || return

# Completion and editing.
if [[ -r /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
elif [[ -r /etc/bash_completion ]]; then
    source /etc/bash_completion
fi

set -o vi

for key in '\C-k' '\e[A' '\eOA' '\C-p'; do
    bind '"'"$key"'": history-search-backward'
done

for key in '\C-j' '\e[B' '\eOB' '\C-n'; do
    bind '"'"$key"'": history-search-forward'
done
unset key

bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set colored-stats on'
bind 'set colored-completion-prefix on'
bind 'set menu-complete-display-prefix on'

# Append new history and import entries from other sessions.
HISTSIZE=5000
HISTFILESIZE=5000
HISTFILE="$HOME/.bash_history"
HISTCONTROL=ignorespace:erasedups
HISTIGNORE='ls:bg:fg:history:clear'

shopt -s histappend

mono::history_sync() {
    history -a
    history -n
}
if [[ ${MONO_BASH_HISTORY_READY:-false} != true ]]; then
    if [[ $(declare -p PROMPT_COMMAND 2> /dev/null) != 'declare -a '* ]]; then
        PROMPT_COMMAND=("${PROMPT_COMMAND[0]:-}")
    fi
    PROMPT_COMMAND=(mono::history_sync "${PROMPT_COMMAND[@]}")
    MONO_BASH_HISTORY_READY=true
fi

profile::exists dircolors && eval "$(profile::query dircolors -b)"
profile::exists fzf && eval "$(profile::query fzf --bash)"
profile::exists zoxide && eval "$(profile::query zoxide init --cmd cd bash)"

if profile::exists starship; then
    eval "$(profile::query starship init bash)"
else
    PS1='[\u@\h \W]\$ '
fi

alias g='nvim ~/.bashrc'
alias s='source ~/.bashrc'
