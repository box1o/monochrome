#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly D_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
target="${1:-./d.bl.sh}"

if [[ -e "${target}" ]]; then
    printf 'ERROR: already exists: %s\n' "${target}" >&2
    exit 1
fi

cp -- "${D_SCRIPT_DIR}/d.bl.sh.example" "${target}"
chmod u+x -- "${target}"
printf 'Created: %s\n' "${target}"
