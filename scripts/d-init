#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/.init.sh" || exit $?

script::init
script::parse "$@" || exit $?

if args::has help; then
    script::usage '[PATH]'
    exit 0
fi

script::require_count 0 1 || exit $?

set -- "${SCRIPT_ARGS[@]}"

D_SUPPORT_DIR="${MONO_HELPER_DIR}/d-support"

readonly D_SUPPORT_DIR

target="${1:-./d.bl.sh}"

if [[ -e "${target}" ]]; then
    log::fatal "Already exists: ${target}"
fi

fs::copy_file "${D_SUPPORT_DIR}/d.bl.sh.example" "${target}"
fs::chmod u+x "${target}"

[[ ${SHELL_LIB_DRY_RUN:-false} == true ]] || log::info "Created: ${target}"
