#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/.init.sh" || exit $?

script::init
script::parse "$@" || exit $?

if args::has help; then
    script::usage 'clipboard|monitor ACTION [VALUES...]'
    exit 0
fi

script::require_count 2 8 || exit $?

set -- "${SCRIPT_ARGS[@]}"

mono_shell::clipboard_list() {
    proc::require cliphist || return

    exec::run cliphist list
}

mono_shell::clipboard_copy() {
    local __entry_id__=${1:-}

    validate::not_empty clipboard-entry "${__entry_id__}" || return
    proc::require cliphist wl-copy || return

    printf '%s\t' "${__entry_id__}" | exec::run --quiet -- cliphist decode | clipboard::copy
}

mono_shell::clipboard_wipe() {
    proc::require cliphist || return

    exec::run cliphist wipe
}

mono_shell::monitor_apply() {
    local __name__=${1:-}
    local __mode__=${2:-}
    local __position__=${3:-}
    local __scale__=${4:-}

    [[ "${__name__}" =~ ^[A-Za-z0-9._-]+$ ]] || return 2
    [[ "${__mode__}" =~ ^(preferred|[0-9]+x[0-9]+(@[0-9]+([.][0-9]+)?)?)$ ]] || return 2
    [[ "${__position__}" =~ ^(auto(-(left|right|up|down))?|-?[0-9]+x-?[0-9]+)$ ]] || return 2
    [[ "${__scale__}" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 2

    local transform=${5:-0} vrr=${6:-0}
    local config="${XDG_CONFIG_HOME:-${HOME}/.config}/hypr/settings/monitors.lua"

    [[ "$transform" =~ ^[0-7]$ && "$vrr" =~ ^[0-2]$ ]] || return 2
    fs::require_file monitors "$config" || return
    proc::require lua hyprctl || return

    local helper="${BASH_SOURCE[0]%/*}/../configs/hypr/scripts/update-monitors.lua"
    fs::is_file "$helper" || helper="${config%/settings/monitors.lua}/scripts/update-monitors.lua"
    fs::require_file monitor-helper "$helper" || return

    local content
    content=$(exec::query lua "$helper" "$config" \
        "$__name__" "$__mode__" "$__position__" "$__scale__" "$transform" "$vrr") || return

    printf '%s\n' "$content" | fs::atomic_write "$config" || return
    exec::run hyprctl reload
}

mono_shell::main() {
    local __domain__=${1:-}
    local __action__=${2:-}

    shift 2 2>/dev/null || true

    case "${__domain__}:${__action__}" in
        clipboard:list) mono_shell::clipboard_list "$@" ;;
        clipboard:copy) mono_shell::clipboard_copy "$@" ;;
        clipboard:wipe) mono_shell::clipboard_wipe "$@" ;;
        monitor:apply) mono_shell::monitor_apply "$@" ;;
        *)
            log::error "Unsupported shell operation: ${__domain__} ${__action__}"
            return 2
            ;;
    esac
}

mono_shell::main "$@"
